{
  "name": "@ai-swfactory-oss/clibind-sdk",
  "description": "The clibind compiler: binds a CLI to an existing TypeScript SDK's typed operations and compiles it, taking plain data and returning files.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory-oss/clibind.git",
    "directory": "packages/clibind-sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "tag": "latest"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tgz"
  ],
  "dependencies": {
    "@ai-swfactory-oss/files": "^6.0.1",
    "@ai-swfactory-oss/typescript": "^3.0.0",
    "@ai-swfactory-oss/typescript-source": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
